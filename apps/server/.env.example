# Copy to .env (never commit the real file) or set these in your host's environment.
NODE_ENV=development
PORT=8787
# Public URL of the web app — used in magic sign-in links.
PUBLIC_URL=http://localhost:5173
# Leave empty to use the embedded Postgres (PGlite) in DATA_DIR. Set for a real PostgreSQL server.
DATABASE_URL=
DATA_DIR=./data
# REQUIRED in production: 32 random bytes, base64. Generate: openssl rand -base64 32
VAULT_MASTER_KEY=
# Previous master keys (comma-separated) while rotating.
VAULT_OLD_KEYS=
# Email for magic links, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Multi-functional Creator <no-reply@example.com>"
# Print sign-in links to the server log (self-hosting without SMTP).
MAGIC_LINK_CONSOLE=0
# Optional server-wide fallback key for the copilot. Prefer storing ANTHROPIC_API_KEY in the vault.
ANTHROPIC_API_KEY=
# Extra allowed CORS origins, comma separated (same-origin needs none).
CORS_ORIGINS=
# Let the API tester, workflows, deploy targets and monitors reach private network addresses (SSRF guard off).
ALLOW_PRIVATE_NETWORK=0
# Shared secret for GET /api/cron/tick (external cron / Vercel Cron), sent as "Authorization: Bearer <secret>".
CRON_SECRET=
# Set to 0 to turn off the built-in scheduler (workflows, uptime checks) on a long-running server.
SCHEDULER=1

# --- SaaS billing (optional). Without STRIPE_SECRET_KEY billing is off and every workspace is unlimited. ---
STRIPE_SECRET_KEY=
# Webhook endpoint: <PUBLIC_URL>/api/billing/webhook (events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Free trial length for new subscriptions (days, 0 = none).
STRIPE_TRIAL_DAYS=0

# --- Web Push (optional). Keys are generated and stored encrypted in the database when not set. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Download links shown in Settings → Devices & apps (optional). ---
DESKTOP_DOWNLOAD_URL=
ANDROID_DOWNLOAD_URL=
IOS_DOWNLOAD_URL=
